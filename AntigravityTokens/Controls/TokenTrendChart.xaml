<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AntigravityTokens.Controls.TokenTrendChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Height="280" Background="Transparent" SizeChanged="RootGrid_SizeChanged">
        <!-- Background Chart Canvas -->
        <Canvas x:Name="ChartCanvas" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                PointerMoved="ChartCanvas_PointerMoved"
                PointerExited="ChartCanvas_PointerExited"
                Background="Transparent" />

        <!-- Empty State Message -->
        <StackPanel x:Name="EmptyStatePanel" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Spacing="8" 
                    Visibility="Collapsed">
            <FontIcon Glyph="&#xE9D2;" FontSize="32" Opacity="0.4" />
            <TextBlock Text="该时间范围内暂无 Token 消耗数据" Opacity="0.6" FontSize="14" />
        </StackPanel>

        <!-- Hover Crosshair & Tooltip Overlay Canvas -->
        <Canvas x:Name="OverlayCanvas" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                IsHitTestVisible="False">
            <!-- Vertical Crosshair Line -->
            <Line x:Name="CrosshairLine" 
                  Stroke="{ThemeResource AccentFillColorDefaultBrush}" 
                  StrokeDashArray="2,2" 
                  StrokeThickness="1.5" 
                  Opacity="0.75" 
                  Visibility="Collapsed" />

            <!-- Point Dot Indicator -->
            <Ellipse x:Name="PointDot" 
                     Width="12" Height="12" 
                     Fill="#3B82F6" 
                     Stroke="White" 
                     StrokeThickness="2.5" 
                     Visibility="Collapsed" />

            <!-- Floating Tooltip Card -->
            <Border x:Name="TooltipCard" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="12,10" 
                    Visibility="Collapsed">
                <StackPanel Spacing="6" MinWidth="160">
                    <TextBlock x:Name="TooltipDate" FontWeight="Bold" FontSize="13" />

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="#3B82F6" VerticalAlignment="Center" />
                            <TextBlock Text="消耗总量" FontSize="12" Opacity="0.7" />
                        </StackPanel>
                        <TextBlock x:Name="TooltipTotal" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" Foreground="#3B82F6" />
                    </Grid>

                    <Grid>
                        <TextBlock Text="输入 Prompt" FontSize="11" Opacity="0.6" />
                        <TextBlock x:Name="TooltipPrompt" HorizontalAlignment="Right" FontSize="11" Opacity="0.8" />
                    </Grid>

                    <Grid>
                        <TextBlock Text="输出 Output" FontSize="11" Opacity="0.6" />
                        <TextBlock x:Name="TooltipOutput" HorizontalAlignment="Right" FontSize="11" Opacity="0.8" />
                    </Grid>

                    <Grid>
                        <TextBlock Text="调用请求" FontSize="11" Opacity="0.6" />
                        <TextBlock x:Name="TooltipCalls" HorizontalAlignment="Right" FontSize="11" Opacity="0.8" />
                    </Grid>

                    <Grid>
                        <TextBlock Text="预估花费" FontSize="11" Opacity="0.6" />
                        <TextBlock x:Name="TooltipCost" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" />
                    </Grid>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
