<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AntigravityTokens.Views.AnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AntigravityTokens.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch">

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="统计分析" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="深度分析每日 Token 走势、思考深度 (Thinking Token) 与调用频次" Opacity="0.7" FontSize="13" />
                </StackPanel>

                <Button Grid.Column="1" Command="{x:Bind ViewModel.RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        <TextBlock Text="刷新分析" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 3 Highlight Cards -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="累计活跃统计跨度" FontSize="13" Opacity="0.7" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.TotalDaysText, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#3B82F6" />
                        <TextBlock Text="按本地 SQLite 对话时间跨度归集" FontSize="11" Opacity="0.5" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="日均 Token 吞吐量" FontSize="13" Opacity="0.7" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.AvgDailyTokensText, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#10B981" />
                        <TextBlock Text="平均每个活跃日消耗的 Tokens" FontSize="11" Opacity="0.5" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="全局显式思考 Token 占比" FontSize="13" Opacity="0.7" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.OverallThinkingRatioText, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#F59E0B" />
                        <TextBlock Text="Thinking Tokens 占模型总输出的百分比" FontSize="11" Opacity="0.5" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Daily History Table -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="0">
                    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="日期" FontWeight="SemiBold" FontSize="12" Opacity="0.7" />
                        <TextBlock Grid.Column="1" Text="输入 Tokens" FontWeight="SemiBold" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="补全 Tokens" FontWeight="SemiBold" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="思考 Tokens" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Foreground="#F59E0B" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="思考占比" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Foreground="#F59E0B" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="每日总计" FontWeight="SemiBold" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="6" Text="调用次数" FontWeight="SemiBold" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="7" Text="折算费用" FontWeight="SemiBold" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" Margin="0,0,16,0" />
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.DailyItems, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DailyTokenStat">
                                <Grid Padding="4,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind Date}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind FormattedPromptTokens}" 
                                               FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind FormattedOutputTokens}" 
                                               FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind FormattedThinkingTokens}" 
                                               FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind FormattedThinkingRatio}" 
                                               FontSize="12" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind FormattedTotalTokens}" 
                                               FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind CallsText}" 
                                               FontSize="12" Opacity="0.8" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="7" Text="{x:Bind FormattedCost}" 
                                               FontSize="12" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
