<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AntigravityTokens.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AntigravityTokens.Controls"
    xmlns:models="using:AntigravityTokens.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch">

            <!-- Clean Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="总览看板" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="实时监控 Google Antigravity 本地模型 Token 消耗与成本" Opacity="0.6" FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.ToggleCurrencyCommand}" ToolTipService.ToolTip="切换当前结算货币 (USD / CNY)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C7;" FontSize="14" />
                            <TextBlock Text="{x:Bind ViewModel.Currency, Mode=OneWay}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="立即刷新" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 4 NewAPI-Style Core Metric Cards -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1: Total Cost -->
                <Border Grid.Column="0" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C7;" Foreground="#10B981" FontSize="18" />
                            <TextBlock Text="累计预估花费" FontSize="14" Opacity="0.8" FontWeight="SemiBold" />
                        </StackPanel>

                        <controls:RollingNumberTicker 
                            Value="{x:Bind ViewModel.TotalCost, Mode=OneWay}"
                            Prefix="{x:Bind ViewModel.CurrencySymbol, Mode=OneWay}"
                            FormatString="F4"
                            ValueFontSize="28" />

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.75">
                            <TextBlock Text="今日消耗:" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.CurrencySymbol, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.TodayCost, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 2: Total Tokens -->
                <Border Grid.Column="1" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" Foreground="#3B82F6" FontSize="18" />
                            <TextBlock Text="累计总 Tokens" FontSize="14" Opacity="0.8" FontWeight="SemiBold" />
                        </StackPanel>

                        <controls:RollingNumberTicker 
                            Value="{x:Bind ViewModel.TotalTokens, Mode=OneWay}"
                            FormatString="N0"
                            ValueFontSize="28" />

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
                        <StackPanel Spacing="3" Opacity="0.8">
                            <Grid>
                                <TextBlock Text="输入 Prompt:" FontSize="12" HorizontalAlignment="Left" />
                                <TextBlock Text="{x:Bind ViewModel.PromptTokens, Mode=OneWay}" FontSize="12" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="思考 Thinking:" FontSize="12" Foreground="#F59E0B" HorizontalAlignment="Left" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.ThinkingTokens, Mode=OneWay}" FontSize="12" Foreground="#F59E0B" FontWeight="SemiBold" />
                                    <TextBlock Text=" (" FontSize="12" Foreground="#F59E0B" />
                                    <TextBlock Text="{x:Bind ViewModel.ThinkingRatioText, Mode=OneWay}" FontSize="12" Foreground="#F59E0B" FontWeight="Bold" />
                                    <TextBlock Text=")" FontSize="12" Foreground="#F59E0B" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 3: Total Calls -->
                <Border Grid.Column="2" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BF;" Foreground="#8B5CF6" FontSize="18" />
                            <TextBlock Text="累计请求轮次" FontSize="14" Opacity="0.8" FontWeight="SemiBold" />
                        </StackPanel>

                        <controls:RollingNumberTicker 
                            Value="{x:Bind ViewModel.TotalCalls, Mode=OneWay}"
                            FormatString="N0"
                            ValueFontSize="28" />

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.75">
                            <TextBlock Text="今日请求:" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.TodayCalls, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="次" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 4: Avg Latency -->
                <Border Grid.Column="3" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE916;" Foreground="#EC4899" FontSize="18" />
                            <TextBlock Text="平均响应耗时" FontSize="14" Opacity="0.8" FontWeight="SemiBold" />
                        </StackPanel>

                        <controls:RollingNumberTicker 
                            Value="{x:Bind ViewModel.AvgLatency, Mode=OneWay}"
                            Suffix=" s"
                            FormatString="F2"
                            ValueFontSize="28" />

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.75">
                            <TextBlock Text="单轮交互平均等待时间" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Token Consumption Trend Line Chart Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <!-- Chart Header & Toolbar -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Title & Range Summary -->
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE9D2;" FontSize="18" Foreground="#3B82F6" />
                                <TextBlock Text="Token 消耗趋势折线图" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.75">
                                <TextBlock Text="{x:Bind ViewModel.SelectedPresetText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontSize="12" />
                                <TextBlock Text="·" FontSize="12" />
                                <TextBlock Text="{x:Bind ViewModel.RangeDateRangeText, Mode=OneWay}" FontWeight="Medium" FontSize="12" />
                                <TextBlock Text="·" FontSize="12" />
                                <TextBlock Text="{x:Bind ViewModel.RangeTotalTokensText, Mode=OneWay}" Foreground="#3B82F6" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="·" FontSize="12" />
                                <TextBlock Text="{x:Bind ViewModel.RangeTotalCallsText, Mode=OneWay}" FontSize="12" />
                                <TextBlock Text="·" FontSize="12" />
                                <TextBlock Text="{x:Bind ViewModel.RangeTotalCostText, Mode=OneWay}" Foreground="#10B981" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Range Preset Buttons and Custom Date Range -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Content="周" 
                                    Command="{x:Bind ViewModel.SelectPresetCommand}" CommandParameter="周"
                                    Padding="10,5" FontSize="12" />
                            <Button Content="月" 
                                    Command="{x:Bind ViewModel.SelectPresetCommand}" CommandParameter="月"
                                    Padding="10,5" FontSize="12" />
                            <Button Content="季度" 
                                    Command="{x:Bind ViewModel.SelectPresetCommand}" CommandParameter="季度"
                                    Padding="10,5" FontSize="12" />
                            <Button Content="半年" 
                                    Command="{x:Bind ViewModel.SelectPresetCommand}" CommandParameter="半年"
                                    Padding="10,5" FontSize="12" />
                            <Button Content="-1年" 
                                    Command="{x:Bind ViewModel.SelectPresetCommand}" CommandParameter="-1年"
                                    Padding="10,5" FontSize="12" />
                            <Button Content="全部" 
                                    Command="{x:Bind ViewModel.SelectPresetCommand}" CommandParameter="全部"
                                    Padding="10,5" FontSize="12" />

                            <!-- Custom Date Range Flyout -->
                            <Button ToolTipService.ToolTip="自定义时间范围" Padding="10,5">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE787;" FontSize="12" />
                                    <TextBlock Text="自定义" FontSize="12" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel Spacing="12" Width="260">
                                            <TextBlock Text="选择自定义时间范围" FontWeight="SemiBold" FontSize="14" />
                                            <CalendarDatePicker Header="开始日期" 
                                                                Date="{x:Bind ViewModel.CustomStartDate, Mode=TwoWay}" 
                                                                HorizontalAlignment="Stretch" />
                                            <CalendarDatePicker Header="结束日期" 
                                                                Date="{x:Bind ViewModel.CustomEndDate, Mode=TwoWay}" 
                                                                HorizontalAlignment="Stretch" />
                                            <Button Content="确定应用" 
                                                    Style="{ThemeResource AccentButtonStyle}" 
                                                    Command="{x:Bind ViewModel.ApplyCustomRangeCommand}" 
                                                    HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Native WinUI 3 Chart Control -->
                    <controls:TokenTrendChart ItemsSource="{x:Bind ViewModel.ChartPoints, Mode=OneWay}" 
                                              CurrencySymbol="{x:Bind ViewModel.CurrencySymbol, Mode=OneWay}" 
                                              Height="280" />
                </StackPanel>
            </Border>

            <!-- Model and Workspace Breakdown Lists -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Top Models -->
                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="#3B82F6" />
                            <TextBlock Text="模型消耗排行榜" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.TopModels, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ModelUsageStat">
                                    <StackPanel Margin="0,6" Spacing="4">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                                <TextBlock Text="{x:Bind Model}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{x:Bind CallsText}" 
                                                           Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind FormattedTokens}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{x:Bind FormattedPercentage}" Foreground="#3B82F6" FontWeight="Bold" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar Value="{x:Bind Percentage}" Maximum="100" Height="5" CornerRadius="3" Foreground="#3B82F6" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Top Workspaces (Resolved from trajectory_metadata_blob) -->
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="#8B5CF6" />
                            <TextBlock Text="项目/工作区消耗排行" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.TopWorkspaces, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:WorkspaceUsageStat">
                                    <StackPanel Margin="0,6" Spacing="4">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                                <TextBlock Text="{x:Bind Workspace}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{x:Bind CallsText}" 
                                                           Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind FormattedTokens}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{x:Bind FormattedPercentage}" Foreground="#8B5CF6" FontWeight="Bold" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar Value="{x:Bind Percentage}" Maximum="100" Height="5" CornerRadius="3" Foreground="#8B5CF6" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
