<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AntigravityTokens.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AntigravityTokens.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="日志明细" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="查看每一次 LLM 调用的精确输入、输出、思考 Token 与耗时记录" Opacity="0.7" FontSize="13" />
            </StackPanel>

            <Button Grid.Column="1" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.ExportCsvCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                    <TextBlock Text="导出 CSV 报表" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Filter Toolbar -->
        <Border Grid.Row="1" 
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <TextBox Grid.Column="0" 
                         PlaceholderText="搜索标题 / 模型 / UUID..." 
                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Date Range -->
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.AvailableDateRanges}"
                          SelectedItem="{x:Bind ViewModel.SelectedDateRange, Mode=TwoWay}" />

                <!-- Model -->
                <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.AvailableModels, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}" />

                <!-- Workspace -->
                <ComboBox Grid.Column="3" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.AvailableWorkspaces, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedWorkspace, Mode=TwoWay}" />

                <!-- Apply Filter -->
                <Button Grid.Column="4" Command="{x:Bind ViewModel.ApplyFilterCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71C;" FontSize="13" />
                        <TextBlock Text="筛选" />
                    </StackPanel>
                </Button>

                <!-- Reset -->
                <Button Grid.Column="5" Command="{x:Bind ViewModel.ResetFilterCommand}">
                    <FontIcon Glyph="&#xE7A7;" FontSize="13" />
                </Button>
            </Grid>
        </Border>

        <!-- Table View -->
        <Border Grid.Row="2" 
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Table Header -->
                <Grid Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="时间" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="对话 / 项目工作区" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
                    <TextBlock Grid.Column="2" Text="模型" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
                    <TextBlock Grid.Column="3" Text="提示 Tokens" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="补全 Tokens" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="思考 Tokens" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" Foreground="#F59E0B" />
                    <TextBlock Grid.Column="6" Text="总计 Tokens" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="7" Text="耗时" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="8" Text="费用" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="9" Text="详情" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" />
                </Grid>

                <!-- Table Rows -->
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TokenCallItem">
                            <Grid Padding="4,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>

                                <!-- Time -->
                                <TextBlock Grid.Column="0" Text="{x:Bind FormattedTime}" FontSize="12" Opacity="0.8" VerticalAlignment="Center" />

                                <!-- Title and Workspace -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Workspace}" FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Model Pill Badge -->
                                <Border Grid.Column="2" 
                                        Background="#1E293B" 
                                        BorderBrush="#334155" 
                                        BorderThickness="1" 
                                        CornerRadius="4" 
                                        Padding="6,2" 
                                        HorizontalAlignment="Left" 
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Model}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" />
                                </Border>

                                <!-- Prompt -->
                                <TextBlock Grid.Column="3" Text="{x:Bind FormattedPromptTokens}" 
                                           FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                <!-- Candidate -->
                                <TextBlock Grid.Column="4" Text="{x:Bind FormattedCandidateTokens}" 
                                           FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                <!-- Thinking -->
                                <TextBlock Grid.Column="5" Text="{x:Bind FormattedThinkingTokens}" 
                                           FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                <!-- Total -->
                                <TextBlock Grid.Column="6" Text="{x:Bind FormattedTotalTokens}" 
                                           FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                <!-- Latency -->
                                <TextBlock Grid.Column="7" Text="{x:Bind FormattedLatency}" 
                                           FontSize="12" Opacity="0.75" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                <!-- Cost -->
                                <TextBlock Grid.Column="8" Text="{x:Bind FormattedCost}" 
                                           FontSize="12" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                <!-- Detail Action -->
                                <Button Grid.Column="9" Padding="4" Background="Transparent" BorderThickness="0" 
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Click="OnDetailButtonClick" Tag="{x:Bind}">
                                    <FontIcon Glyph="&#xE946;" FontSize="14" Opacity="0.7" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Pagination -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.PageInfo, Mode=OneWay}" 
                       FontSize="13" Opacity="0.7" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.PreviousPageCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE76B;" FontSize="12" />
                        <TextBlock Text="上一页" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.NextPageCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="下一页" />
                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
