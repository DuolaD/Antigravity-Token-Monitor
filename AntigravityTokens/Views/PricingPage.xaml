<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AntigravityTokens.Views.PricingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AntigravityTokens.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch">

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="模型费率配置" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="参考 NewAPI 模型倍率管理，自定义配置各模型每 100 万 (1M) Tokens 的结算价格" Opacity="0.7" FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.ResetDefaultsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE777;" FontSize="13" />
                            <TextBlock Text="重置为默认" />
                        </StackPanel>
                    </Button>
                    <Button Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.SavePricingCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="13" />
                            <TextBlock Text="保存费率配置" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Status Message Bar -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}" 
                     Severity="Success" 
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     IsClosable="True" />

            <!-- Currency Settings Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="结算币种 (Currency)" FontWeight="SemiBold" FontSize="13" />
                        <ComboBox HorizontalAlignment="Stretch" 
                                  ItemsSource="{x:Bind ViewModel.CurrencyOptions}"
                                  SelectedItem="{x:Bind ViewModel.Currency, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="USD / CNY 换算汇率" FontWeight="SemiBold" FontSize="13" />
                        <NumberBox Value="{x:Bind ViewModel.UsdToCnyRate, Mode=TwoWay}" 
                                   SpinButtonPlacementMode="Inline" 
                                   SmallChange="0.05" LargeChange="0.5" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Pricing Table -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="0">
                    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="模型标识" FontWeight="SemiBold" FontSize="12" Opacity="0.7" />
                        <TextBlock Grid.Column="1" Text="显示名称" FontWeight="SemiBold" FontSize="12" Opacity="0.7" />
                        <TextBlock Grid.Column="2" Text="输入单价 ($ / 1M Tokens)" FontWeight="SemiBold" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="输出单价 ($ / 1M Tokens)" FontWeight="SemiBold" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" Margin="0,0,16,0" />
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.PricingItems, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ModelPricing">
                                <Grid Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind ModelId}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{x:Bind DisplayName, Mode=TwoWay}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <NumberBox Grid.Column="2" Value="{x:Bind PromptPricePerMillion, Mode=TwoWay}" 
                                               SpinButtonPlacementMode="Compact" 
                                               SmallChange="0.05"
                                               HorizontalAlignment="Right" Width="150" VerticalAlignment="Center" />
                                    <NumberBox Grid.Column="3" Value="{x:Bind OutputPricePerMillion, Mode=TwoWay}" 
                                               SpinButtonPlacementMode="Compact" 
                                               SmallChange="0.10"
                                               HorizontalAlignment="Right" Width="150" VerticalAlignment="Center" Margin="0,0,16,0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
