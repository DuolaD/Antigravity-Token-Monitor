<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AntigravityTokens.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="20" MaxWidth="1000" HorizontalAlignment="Left">

            <StackPanel Spacing="4">
                <TextBlock Text="系统设置" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="配置数据探测源、高频实时同步与应用偏好" Opacity="0.7" FontSize="13" />
            </StackPanel>

            <!-- Live Sync Settings -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="实时监听与心跳刷新" FontSize="16" FontWeight="SemiBold" />

                    <Grid>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="启用 1 秒级动态心跳探测" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="开启后应用将在后台双轨检测 SQLite WAL 写入，对话产生时毫秒级跳动更新" Opacity="0.6" FontSize="12" />
                        </StackPanel>
                        <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.IsLiveSyncEnabled, Mode=TwoWay}" 
                                      Toggled="OnLiveSyncToggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Monitored Paths -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="已探测并绑定的 Antigravity 数据源" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="系统自动识别以下会话存储路径中的 .db 数据库文件：" Opacity="0.6" FontSize="12" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.MonitoredPaths, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                                        BorderThickness="1" 
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        CornerRadius="6" Padding="12,8" Margin="0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xED25;" FontSize="14" Foreground="#10B981" />
                                        <TextBlock Text="{x:Bind}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- About App -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="关于 Antigravity Token Monitor" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="专为 Google Antigravity 设计的原生 Token 计量与费用监控客户端" Opacity="0.7" FontSize="13" />
                    <TextBlock Text="{x:Bind ViewModel.AppVersion}" Opacity="0.5" FontSize="12" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
